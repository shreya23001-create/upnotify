# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_ENV=development

# Admin
ADMIN_EMAILS=sachindiwaker@gmail.com
ADMIN_REPORT_EMAIL=reports@uptrue.io

# AI (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Resend (Email)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=alerts@uptrue.io
RESEND_FROM_NAME=Uptrue Alerts
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# Analytics — set in Vercel production env vars only; leave blank in dev/staging
# GA4 measurement ID — configure as a tag inside GTM, not injected directly
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Tag Manager — public pages only; /admin/* and /dashboard/* are always excluded
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Razorpay (India / INR billing)
# Get keys from: Razorpay Dashboard → Settings → API Keys
# Webhook secret: Razorpay Dashboard → Settings → Webhooks → your webhook → secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cron
CRON_SECRET=your_cron_secret

# AOE — Automated Outreach Engine
AOE_UNSUBSCRIBE_SECRET=your_aoe_unsubscribe_secret

# Support webhook (optional — set to forward support tickets to external tools)
SUPPORT_API_KEY=your_support_api_key
SUPPORT_WEBHOOK_URL=https://your-webhook-endpoint.example.com/support
SUPPORT_WEBHOOK_SECRET=your_support_webhook_secret

# X (Twitter) API — Automated Outage Blog Posts
# Create app at developer.twitter.com → OAuth 1.0a → Read+Write permissions
X_CONSUMER_KEY=your_x_consumer_key
X_CONSUMER_SECRET=your_x_consumer_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_BEARER_TOKEN=your_x_bearer_token

# LinkedIn API — Automated Outage Blog Posts
# Create app at developer.linkedin.com → request w_organization_social scope
# LINKEDIN_ORGANIZATION_ID is the numeric ID from your LinkedIn company page URL
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_MEMBER_ID=your_linkedin_member_id
LINKEDIN_ORGANIZATION_ID=your_linkedin_organization_numeric_id

# Telegram — Admin alerts (support tickets, blog approvals)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Blog Auto-Publish
# Random secret — used internally for token generation
BLOG_APPROVAL_SECRET=your_blog_approval_secret

# AI Visibility — AES-256 key for encrypting engine API keys in DB (generate: openssl rand -hex 32)
AI_ENGINE_ENCRYPTION_SECRET=your_64_char_hex_string

# Internal feature flags (leave unset in production unless intentionally overriding)
# ALLOW_SIMULATION=true
# COST_PER_CHECK_MILLIPENCE=1
